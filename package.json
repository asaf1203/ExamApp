{
  "name": "exam-app-server",
  "version": "1.0.0",
  "description": "Initial Express server for the ExamApp project.",
  "main": "server.js",
  "scripts": {
    "client:dev:mock": "npm --prefix client run dev:mock",
    "client:dev:server": "npm --prefix client run dev:server",
    "start": "node server.js",
    "start:prod": "npm run db:schema && node server.js",
    "dev": "node --watch server.js",
    "db:schema": "node server/db/runSchema.js",
    "db:seed": "node server/db/seed.js",
    "db:test": "node server/db/testConnection.js",
    "db:compat": "node server/db/compatibilityTest.js",
    "test:auth": "node --test server/tests/authorization.test.js"
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "pg": "^8.21.0"
  },
  "devDependencies": {
    "supertest": "^7.2.2"
  }
}
