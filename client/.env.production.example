VITE_APP_NAME="E-Test System"
VITE_APP_TITLE="Exam Platform"
VITE_APP_DESCRIPTION="Online exams for teachers and students."

VITE_API_DATA_SOURCE=http
VITE_API_BASE_URL=https://api.example.com/api
VITE_API_TIMEOUT_MS=10000
VITE_MOCK_API_DELAY_MS=0

