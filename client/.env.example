# Vite exposes only VITE_* variables to the browser bundle.
# Copy this file to .env.local for local development overrides.
# Never put backend secrets, database passwords, or signing keys in this file.

VITE_APP_ENV=development
VITE_APP_NAME="E-Test System"
VITE_APP_TITLE="Mock Exam Platform"
VITE_APP_DESCRIPTION="React components prepared for a future Node.js backend."
VITE_APP_VERSION="0.0.0"
VITE_SUPPORT_EMAIL="support@example.com"

# mock keeps the app fully local. Use http when a backend API is ready.
VITE_API_BACKEND=mock
VITE_API_BASE_URL=/api
VITE_AUTH_API_URL=/api/auth
VITE_API_VERSION=v1
VITE_API_TIMEOUT_MS=10000
VITE_API_RETRY_COUNT=1
VITE_API_RETRY_DELAY_MS=250
VITE_API_CACHE_TTL_MS=30000
VITE_STUDENT_API_CACHE_TTL_MS=10000
VITE_TEACHER_API_CACHE_TTL_MS=8000
VITE_ENABLE_REQUEST_LOGGING=true

VITE_AUTH_TOKEN_KEY=examPlatform.authToken
VITE_AUTH_REFRESH_TOKEN_KEY=examPlatform.refreshToken
VITE_AUTH_SESSION_TTL_MS=28800000
VITE_AUTH_REFRESH_TTL_MS=604800000
VITE_MOCK_AUTH_ENABLED=true

VITE_MOCK_API_DELAY_MS=450
VITE_MOCK_ENABLE_LATENCY=true
VITE_MOCK_ENABLE_ERRORS=false
VITE_MOCK_API_ERROR_RATE=0
VITE_MOCK_DB_STORAGE_KEY=examPlatform.mockDb.v2
VITE_MOCK_PERSIST_DB=true

VITE_EXAM_AUTOSAVE_DEBOUNCE_MS=900
VITE_EXAM_PAGE_SIZE=20
VITE_TEACHER_EXAM_AUTOSAVE_DEBOUNCE_MS=1000
VITE_TEACHER_DRAFT_STORAGE_KEY=examPlatform.teacher.newExamDraft

VITE_FEATURE_REGISTRATION=true
VITE_FEATURE_PASSWORD_RESET=true
VITE_FEATURE_STUDENT_PORTAL=true
VITE_FEATURE_TEACHER_DASHBOARD=true
VITE_FEATURE_TEACHER_EXAM_MANAGEMENT=true
VITE_FEATURE_DARK_MODE=true
VITE_FEATURE_NOTIFICATIONS=true
VITE_FEATURE_ANALYTICS=false
VITE_FEATURE_EXPERIMENTAL=false
VITE_FEATURE_REMOTE_CONFIG=false
VITE_FEATURE_CONFIG_DEBUG_PANEL=true

VITE_UI_DEFAULT_THEME=system
VITE_THEME_STORAGE_KEY=examPlatform.theme
VITE_TOAST_DURATION_MS=4500
VITE_UI_COUNTDOWN_TICK_MS=1000
VITE_NOTIFICATION_POLL_MS=30000

VITE_ENABLE_CONFIG_DIAGNOSTICS=true
VITE_ENABLE_CONSOLE_LOGGING=true
VITE_LOG_LEVEL=info

VITE_ANALYTICS_ENABLED=false
VITE_ANALYTICS_PROVIDER=none
VITE_ANALYTICS_SAMPLE_RATE=0

VITE_LOCALE=en-US
VITE_FALLBACK_LOCALE=en-US
VITE_TIMEZONE=local

# Runtime config can be injected through window.__EXAM_APP_CONFIG__ by a host page
# or container entrypoint before the React bundle loads.
VITE_RUNTIME_CONFIG_ENABLED=true
VITE_ALLOW_RUNTIME_CONFIG=true
VITE_REMOTE_CONFIG_URL=
