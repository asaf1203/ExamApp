# Vite exposes only VITE_* variables to the browser bundle.
# Copy this file to .env.local for local development overrides.

VITE_APP_NAME="E-Test System"
VITE_APP_TITLE="Mock Exam Platform"
VITE_APP_DESCRIPTION="React components prepared for a future Node.js backend."

# mock keeps the app fully local. Use http when a backend API is ready.
VITE_API_DATA_SOURCE=mock
VITE_API_BASE_URL=/api
VITE_API_TIMEOUT_MS=10000
VITE_MOCK_API_DELAY_MS=450

VITE_AUTH_TOKEN_KEY=examPlatform.authToken
VITE_AUTH_SESSION_TTL_MS=28800000

VITE_FEATURE_REGISTRATION=true
VITE_FEATURE_STUDENT_PORTAL=true
VITE_FEATURE_TEACHER_DASHBOARD=true
